APP_NAME="Garudo B2B Marketplace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=garudo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file
CACHE_PREFIX=garudo_

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@garudo.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Garudo Marketplace Specific Configs
MARKETPLACE_NAME="Garudo B2B Marketplace"
MARKETPLACE_CURRENCY=INR
MARKETPLACE_CURRENCY_SYMBOL=₹
MARKETPLACE_DEFAULT_COMMISSION=10
MARKETPLACE_LOW_STOCK_THRESHOLD=10
MARKETPLACE_OTP_EXPIRY=10
MARKETPLACE_SUPPORT_EMAIL=support@garudo.com
MARKETPLACE_SUPPORT_PHONE=+911234567890

# Super Admin & Deployment Configuration
MIGRATION_SECRET_KEY=GarudoB2bDeploy2026SecretKeySecure!
SUPER_ADMIN_EMAIL=admin@garudo.com
SUPER_ADMIN_PASSWORD=Garudo@Admin2026#Secure!
